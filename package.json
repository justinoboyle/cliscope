{
  "name": "cliscope",
  "version": "0.0.0-development",
  "description": "Print command counts and activity graphs from shell history",
  "homepage": "https://github.com/justinoboyle/cliscope#readme",
  "bugs": {
    "url": "https://github.com/justinoboyle/cliscope/issues"
  },
  "license": "MIT",
  "author": "Justin O'Boyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinoboyle/cliscope.git"
  },
  "bin": {
    "cliscope": "dist/launcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file src/cli.ts",
    "build": "bun scripts/build-package.ts && npm run bench -- --startup",
    "build:binary": "bun scripts/build-binary.ts && npm run bench -- --binary",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --import tsx --test test/*.test.ts && npm run bench",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "verify": "npm run check && npm test && npm run build && npm run build:binary",
    "prepack": "npm run check && npm test && npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "bench": "node --import tsx scripts/benchmark.ts",
    "package:github": "node --import tsx scripts/package-github.ts",
    "release": "node --import tsx scripts/release.ts"
  },
  "dependencies": {
    "bun": "1.4.2"
  },
  "devDependencies": {
    "@opentui/core": "0.5.12",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "eslint-plugin-sonarjs": "4.2.1",
    "fast-check": "4.10.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "string-width": "8.3.0",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.5.12",
    "@opentui/core-darwin-x64": "0.5.12",
    "@opentui/core-linux-arm64": "0.5.12",
    "@opentui/core-linux-arm64-musl": "0.5.12",
    "@opentui/core-linux-x64": "0.5.12",
    "@opentui/core-linux-x64-musl": "0.5.12",
    "@opentui/core-win32-arm64": "0.5.12",
    "@opentui/core-win32-x64": "0.5.12"
  },
  "engines": {
    "node": ">=20.13.1"
  },
  "allowScripts": {
    "bun@1.4.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
